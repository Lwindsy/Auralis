{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:auralis:core-import:1",
  "type":"object","additionalProperties":false,
  "required":["format_version","purpose","year","layout_sha256","producer_sha256","created_at","sources","files","exceptions"],
  "properties":{
    "format_version":{"const":1},"purpose":{"const":"private-development"},
    "year":{"type":"integer","minimum":1901,"maximum":9998},
    "layout_sha256":{"$ref":"#/$defs/sha"},"producer_sha256":{"$ref":"#/$defs/sha"},
    "created_at":{"type":"string","maxLength":50},
    "sources":{"type":"object","additionalProperties":false,"required":["musicbrainz","listenbrainz"],"properties":{
      "musicbrainz":{"type":"object"},
      "listenbrainz":{"type":"object","additionalProperties":false,"required":["archive","members"],"properties":{"archive":{"type":"string","maxLength":200},"members":{"type":"object","minProperties":6,"maxProperties":6}}}
    }},
    "files":{"type":"array","minItems":17,"maxItems":17,"items":{"type":"object","additionalProperties":false,"required":["key","path","rows","bytes","sha256"],"properties":{
      "key":{"type":"string","pattern":"^[a-z_]+$"},"path":{"type":"string","pattern":"^[a-z_]+\\.tsv$"},
      "rows":{"type":"integer","minimum":0,"maximum":500000000},"bytes":{"type":"integer","minimum":0,"maximum":100000000000},"sha256":{"$ref":"#/$defs/sha"}
    }}},
    "exceptions":{"type":"object","additionalProperties":false,"required":["path","bytes","sha256","rows","counts"],"properties":{
      "path":{"const":"exceptions.jsonl.gz"},"bytes":{"type":"integer","minimum":0,"maximum":100000000000},"sha256":{"$ref":"#/$defs/sha"},"rows":{"type":"integer","minimum":0},"counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}}
    }}
  },
  "$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
