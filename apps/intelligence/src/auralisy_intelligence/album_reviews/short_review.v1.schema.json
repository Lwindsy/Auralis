{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "refs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "pattern": "^R[1-9][0-9]*$"}}
  },
  "required": ["text", "refs"],
  "additionalProperties": false
}
