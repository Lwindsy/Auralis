{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoritative genre taxonomy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "source_sha256", "core_manifest_sha256", "genres"],
  "properties": {
    "format_version": {"const": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "core_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "genres": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "aliases", "parents"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 160},
          "name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "parents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
