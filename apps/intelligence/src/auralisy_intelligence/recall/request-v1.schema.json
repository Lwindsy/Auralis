{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auralisy local recall request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["limit"],
  "anyOf": [
    {"required": ["seeds"], "properties": {"seeds": {"minItems": 1}}},
    {"required": ["tags"], "properties": {"tags": {"minItems": 1}}},
    {"required": ["disliked_tags"], "properties": {"disliked_tags": {"minItems": 1}}},
    {"required": ["forbidden_tags"], "properties": {"forbidden_tags": {"minItems": 1}}},
    {"required": ["required_tags"], "properties": {"required_tags": {"minItems": 1}}},
    {"required": ["excluded_ids"], "properties": {"excluded_ids": {"minItems": 1}}}
  ],
  "properties": {
    "limit": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["familiar", "explore", "surprise"]},
    "seeds": {"$ref": "#/$defs/preferences"},
    "tags": {"$ref": "#/$defs/preferences"},
    "disliked_tags": {"$ref": "#/$defs/ids"},
    "disliked_exceptions": {"$ref": "#/$defs/ids"},
    "forbidden_tags": {"$ref": "#/$defs/ids"},
    "required_tags": {"$ref": "#/$defs/ids"},
    "excluded_ids": {"$ref": "#/$defs/ids"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "\\S"},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "strength": {"enum": ["normal", "special"]},
          "focused": {"type": "boolean"},
          "weight": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
