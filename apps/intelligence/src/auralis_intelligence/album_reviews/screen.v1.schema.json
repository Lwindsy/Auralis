{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reads": {"type": "array", "minItems": 2, "maxItems": 100, "items": {"type": "object", "properties": {"ref": {"type": "string"}, "about_target": {"enum": ["yes", "no", "unclear"]}, "substantive": {"enum": ["yes", "no"]}}, "required": ["ref", "about_target", "substantive"], "additionalProperties": false}},
    "score": {"type": "integer", "minimum": 1, "maximum": 5},
    "matches": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/evidence"}},
    "tensions": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/evidence"}},
    "unknowns": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 20}},
    "summary": {"type": "string", "minLength": 1, "maxLength": 120}
  },
  "required": ["reads", "score", "matches", "tensions", "unknowns", "summary"],
  "additionalProperties": false,
  "$defs": {"evidence": {"type": "object", "properties": {"pref": {"type": "string"}, "refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}}, "note": {"type": "string", "minLength": 1, "maxLength": 60}}, "required": ["pref", "refs", "note"], "additionalProperties": false}}
}
