{
  "name": "auralis-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixture": "vite --mode fixture",
    "generate": "node scripts/generate.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:fixture": "vite preview --mode fixture",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:java": "playwright test --config playwright.java.config.ts",
    "test:recommendation": "playwright test --config playwright.recommendation.config.ts",
    "check": "tsc -b && eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
