# Local secrets; only sanitized configuration examples belong in Git.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Dependencies, runtimes and caches (enable only the selected toolchain later).
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.gradle/

# Build, test and runtime output.
dist/
build/
target/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
coverage/
.coverage
htmlcov/
playwright-report/
test-results/
*.log
*.tsbuildinfo
*.egg-info/

# Local user data, raw evaluation output, downloads and worktrees.
/local-data/
/tmp/
/.worktrees/
/evals/.local/
/apps/intelligence/artifacts/
/.claude/
/Claude outputs/

# Private document worktree and metadata; excluded from the code repository.
/docs/
/contracts/
/.git-docs/
/.editorconfig
/.github/
/AGENTS.md
/CLAUDE.md
/CONTRIBUTING.md
/WORKSPACE.md
/PROJECT_MAP.md
/PROJECT_STATUS.md
/ARCHITECTURE.md
/TESTS.md
/.docs-governance.json
/scripts/
/infra/
/evals/
/tests/
/apps/**/*.md

# Editor and operating system state.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

